{
  "name": "@hi-ashleyj/llama",
  "description": "A (Very Incomplete) 2D Canvas Game Engine powered by Svelte",
  "cli": "dist/cli/index.js",
  "version": "0.17.0-dev.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "package": "svelte-package",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "svelte-check",
    "test-cli": "svelte-package && node dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi-ashleyj/llama-game-engine.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/hi-ashleyj/llama-game-engine/issues"
  },
  "homepage": "https://github.com/hi-ashleyj/llama-game-engine#readme",
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@sveltepress/cli": "^0.5.1",
    "@sveltepress/theme-default": "^8.11.2",
    "@sveltepress/vite": "^1.10.0",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vite": "^8.3.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "svelte": "./dist/audio.js",
      "import": "./dist/audio.js"
    },
    "./keyboard": {
      "types": "./dist/keyboard.d.ts",
      "svelte": "./dist/keyboard.js",
      "import": "./dist/keyboard.js"
    },
    "./mouse": {
      "types": "./dist/mouse.d.ts",
      "svelte": "./dist/mouse.js",
      "import": "./dist/mouse.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "svelte": "./dist/primitives.js",
      "import": "./dist/primitives.js"
    },
    "./scenes": {
      "types": "./dist/scenes.d.ts",
      "svelte": "./dist/scenes.js",
      "import": "./dist/scenes.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "svelte": "./dist/resources.js",
      "import": "./dist/resources.js"
    },
    "./timers": {
      "types": "./dist/timers.d.ts",
      "svelte": "./dist/timers.js",
      "import": "./dist/timers.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "svelte": "./dist/vite.js",
      "import": "./dist/vite.js"
    }
  },
  "types": "./dist/index.d.ts",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0",
    "detect-package-manager": "^3.0.2",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "$sharp",
    "glob": "^14.0.0",
    "minimatch": "^11.0.1"
  }
}
